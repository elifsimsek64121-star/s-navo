class GoalUniversityScreen extends StatefulWidget {
  const GoalUniversityScreen({super.key});
  @override State<GoalUniversityScreen> createState() => _GoalUniversityScreenState();
}

class _GoalUniversityScreenState extends State<GoalUniversityScreen> {
  List<HedefUniversite> _hedefler = [];
  final _adCtrl    = TextEditingController();
  final _bolumCtrl = TextEditingController();
  final _puanCtrl  = TextEditingController();

  @override
  void initState() { super.initState(); _load(); }

  @override
  void dispose() { _adCtrl.dispose(); _bolumCtrl.dispose(); _puanCtrl.dispose(); super.dispose(); }

  void _load() {
    final raw = AppState.prefs.getStringList('hedef_universiteler') ?? [];
    final list = <HedefUniversite>[];
    for (final s in raw) {
      try { list.add(HedefUniversite.fromJson(jsonDecode(s) as Map<String, dynamic>)); } catch (_) {}
    }
    setState(() => _hedefler = list);
  }

  void _save() {
    if (_adCtrl.text.isEmpty || _bolumCtrl.text.isEmpty || _puanCtrl.text.isEmpty) return;
    _hedefler.add(HedefUniversite(ad: _adCtrl.text.trim(), bolum: _bolumCtrl.text.trim(), minPuan: _puanCtrl.text.trim()));
    unawaited(AppState.prefs.setStringList('hedef_universiteler', _hedefler.map((e) => jsonEncode(e.toJson())).toList()));
    _adCtrl.clear(); _bolumCtrl.clear(); _puanCtrl.clear();
    setState(() {});
  }

  void _delete(int i) {
    _hedefler.removeAt(i);
    unawaited(AppState.prefs.setStringList('hedef_universiteler', _hedefler.map((e) => jsonEncode(e.toJson())).toList()));
    setState(() {});
  }

  /// Son hesaplanan puan ile karşılaştır
  String _compareWithLastScore(String minPuan) {
    final hist = AppState.prefs.getStringList('history') ?? [];
    if (hist.isEmpty) return '';
    try {
      final dec = jsonDecode(hist.first) as Map<String, dynamic>;
      final last = double.tryParse(dec['score']?.toString() ?? '') ?? 0;
      final min  = double.tryParse(minPuan) ?? 0;
      if (min == 0) return '';
      final diff = last - min;
      if (diff >= 0) return '✅ ${diff.toStringAsFixed(1)} puan yukarıdasın!';
      return '⚠️ ${(-diff).toStringAsFixed(1)} puan eksik';
    } catch (_) { return ''; }
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF6F8FA),
      appBar: AppBar(
        title: Text('Hedef Üniversitelerim', style: _ts(size: 17, w: FontWeight.w700, color: Colors.white)),
        backgroundColor: isDark ? kCard : kPrimary, foregroundColor: Colors.white, elevation: 0,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(children: [
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: isDark ? kCard : Colors.white,
              borderRadius: BorderRadius.circular(14),
              border: Border.all(color: isDark ? kBorder : const Color(0xFFE1E4E8)),
            ),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text('Hedef Ekle', style: _ts(size: 16, w: FontWeight.w800, color: isDark ? Colors.white : Colors.black87)),
              const SizedBox(height: 14),
              TextField(controller: _adCtrl, decoration: const InputDecoration(labelText: 'Üniversite Adı', prefixIcon: Icon(Icons.account_balance_rounded, color: kPrimary, size: 20))),
              const SizedBox(height: 10),
              TextField(controller: _bolumCtrl, decoration: const InputDecoration(labelText: 'Bölüm', prefixIcon: Icon(Icons.menu_book_rounded, color: kPrimary, size: 20))),
              const SizedBox(height: 10),
              TextField(controller: _puanCtrl, keyboardType: const TextInputType.numberWithOptions(decimal: true),
                decoration: const InputDecoration(labelText: 'Geçen Yıl Taban Puanı', prefixIcon: Icon(Icons.bar_chart_rounded, color: kPrimary, size: 20))),
              const SizedBox(height: 14),
              SizedBox(width: double.infinity, child: ElevatedButton.icon(onPressed: _save, icon: const Icon(Icons.add_rounded), label: const Text('Hedef Ekle'))),
            ]),
          ),
          const SizedBox(height: 16),
          if (_hedefler.isEmpty)
            Center(child: Padding(padding: const EdgeInsets.all(32), child: Column(children: [
              Icon(Icons.school_outlined, size: 56, color: isDark ? Colors.white24 : Colors.black26),
              const SizedBox(height: 12),
              Text('Henüz hedef eklemediniz.', textAlign: TextAlign.center, style: _ts(size: 14, color: isDark ? Colors.white38 : Colors.black38)),
            ])))
          else
            ...List.generate(_hedefler.length, (i) {
              final h = _hedefler[i];
              final cmp = _compareWithLastScore(h.minPuan);
              final cmpColor = cmp.startsWith('✅') ? kSuccess : kDanger;
              return Container(
                margin: const EdgeInsets.only(bottom: 10),
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: isDark ? kCard : Colors.white,
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: isDark ? kBorder : const Color(0xFFE1E4E8)),
                ),
                child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                  Row(children: [
                    Container(padding: const EdgeInsets.all(10), decoration: BoxDecoration(color: const Color(0x140A84FF), borderRadius: BorderRadius.circular(10)),
                      child: const Icon(Icons.school_rounded, color: kPrimary, size: 20)),
                    const SizedBox(width: 12),
                    Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                      Text(h.ad, style: _ts(size: 14, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
                      Text(h.bolum, style: _ts(size: 12, color: isDark ? Colors.white54 : Colors.black45)),
                    ])),
                    Column(crossAxisAlignment: CrossAxisAlignment.end, children: [
                      Text(h.minPuan, style: _ts(size: 16, w: FontWeight.w800, color: kOrange)),
                      Text('taban puan', style: _ts(size: 10, color: isDark ? Colors.white38 : Colors.black38)),
                    ]),
                    const SizedBox(width: 8),
                    IconButton(icon: const Icon(Icons.delete_outline_rounded, color: kDanger, size: 18), onPressed: () => _delete(i)),
                  ]),
                  if (cmp.isNotEmpty) Padding(
                    padding: const EdgeInsets.only(top: 8),
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                      decoration: BoxDecoration(color: cmpColor.withAlpha(15), borderRadius: BorderRadius.circular(8)),
                      child: Text(cmp, style: _ts(size: 12, w: FontWeight.w700, color: cmpColor)),
                    ),
                  ),
                ]),
              );
            }),
        ]),
      ),
    );
  }
}

