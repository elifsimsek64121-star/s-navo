// ─────────────────────────────────────────────────────────────
class AnalyticsScreen extends StatefulWidget {
  const AnalyticsScreen({super.key});
  @override State<AnalyticsScreen> createState() => _AnalyticsScreenState();
}

class _AnalyticsScreenState extends State<AnalyticsScreen> with AutomaticKeepAliveClientMixin {
  @override bool get wantKeepAlive => true;

  bool _loading = true;
  List<double> _scores = [];
  List<TryoutExam> _tryouts = [];
  String? _weakSec, _bestSec;
  double _minNet = 0, _maxNet = 0;
  Map<String, NetTrendResult> _trends = {};
  WeeklyReport? _weeklyReport;
  Map<String, double> _subjectAverages = {};

  @override
  void initState() { super.initState(); _loadData(); }

  Future<void> _loadData() async {
    if (!mounted) return;
    setState(() => _loading = true);
    final p = AppState.prefs;
    final histRaw = p.getStringList('history')  ?? [];
    final tryRaw  = p.getStringList('tryouts')  ?? [];

    final scores = <double>[];
    for (final h in histRaw) {
      try {
        final dec = jsonDecode(h) as Map<String, dynamic>;
        final s = double.tryParse(dec['score']?.toString() ?? '0');
        if (s != null && s > 0) scores.add(s);
      } catch (_) {}
    }

    final tryouts = <TryoutExam>[];
    for (final s in tryRaw) {
      try { tryouts.add(TryoutExam.fromJson(jsonDecode(s) as Map<String, dynamic>)); } catch (_) {}
    }
    tryouts.sort((a, b) => a.date.compareTo(b.date));

    final netAvg = <String, List<double>>{};
    for (final t in tryouts) {
      t.nets.forEach((sec, net) => netAvg.putIfAbsent(sec, () => []).add(net));
    }
    final avg = netAvg.map((k, v) => MapEntry(k, v.isNotEmpty ? v.reduce((a, b) => a + b) / v.length : 0.0));

    String? weakSec; double minNet = double.infinity;
    String? bestSec; double maxNet = double.negativeInfinity;
    avg.forEach((sec, a) {
      if (a < minNet) { minNet = a; weakSec = sec; }
      if (a > maxNet) { maxNet = a; bestSec = sec; }
    });

    if (!mounted) return;
    setState(() {
      _scores          = scores.take(20).toList().reversed.toList();
      _tryouts         = tryouts;
      _weakSec         = weakSec;
      _minNet          = minNet == double.infinity ? 0 : minNet;
      _bestSec         = bestSec;
      _maxNet          = maxNet == double.negativeInfinity ? 0 : maxNet;
      _trends          = NetTrendAnalyzer.analyze(tryouts.reversed.toList());
      _weeklyReport    = WeeklyReport.generate(tryouts.reversed.toList());
      _subjectAverages = avg;
      _loading         = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    super.build(context);
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF6F8FA),
      appBar: AppBar(
        title: Text('Analiz Paneli', style: _ts(size: 17, w: FontWeight.w700, color: Colors.white)),
        automaticallyImplyLeading: false,
        backgroundColor: isDark ? kCard : kPrimary, foregroundColor: Colors.white, elevation: 0,
        actions: [IconButton(icon: const Icon(Icons.refresh_rounded), onPressed: _loadData)],
      ),
      body: _loading
        ? const Center(child: CircularProgressIndicator())
        : RefreshIndicator(
            onRefresh: _loadData,
            child: SingleChildScrollView(
              physics: const AlwaysScrollableScrollPhysics(),
              padding: const EdgeInsets.all(16),
              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [

                // ─── Haftalık Rapor ───
                if (_weeklyReport != null) _buildWeeklyCard(_weeklyReport!, isDark),

                // ─── Stat Kartları ───
                if (_scores.isNotEmpty) ...[
                  Row(children: [
                    _StatCard(label: 'En Yüksek', value: _scores.reduce(max).toStringAsFixed(0), icon: Icons.arrow_upward_rounded, color: kSuccess, isDark: isDark),
                    const SizedBox(width: 8),
                    _StatCard(label: 'En Düşük',  value: _scores.reduce(min).toStringAsFixed(0), icon: Icons.arrow_downward_rounded, color: kDanger, isDark: isDark),
                    const SizedBox(width: 8),
                    _StatCard(label: 'Ortalama',  value: (_scores.reduce((a, b) => a + b) / _scores.length).toStringAsFixed(0), icon: Icons.horizontal_rule_rounded, color: kWarning, isDark: isDark),
                  ]),
                  const SizedBox(height: 16),
                ],

                // ─── Trend Kartları ───
                if (_trends.isNotEmpty) ...[
                  Text('Net Trendleri', style: _ts(size: 16, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
                  const SizedBox(height: 10),
