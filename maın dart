class TryoutScreen extends StatefulWidget {
  final Function(int, {String? badgeId}) onXPAward;
  final VoidCallback? onTaskComplete;
  const TryoutScreen({super.key, required this.onXPAward, this.onTaskComplete});
  @override State<TryoutScreen> createState() => _TryoutScreenState();
}

class _TryoutScreenState extends State<TryoutScreen> with AutomaticKeepAliveClientMixin {
  @override bool get wantKeepAlive => true;

  List<TryoutExam> _tryouts = [];
  Map<String, NetTrendResult> _trends = {};
  WeeklyReport? _weeklyReport;

  @override
  void initState() { super.initState(); _load(); }

  Future<void> _load() async {
    final data = AppState.prefs.getStringList('tryouts') ?? [];
    final list = <TryoutExam>[];
    for (final s in data) {
      try { list.add(TryoutExam.fromJson(jsonDecode(s) as Map<String, dynamic>)); } catch (_) {}
    }
    list.sort((a, b) => b.date.compareTo(a.date));
    if (!mounted) return;
    setState(() {
      _tryouts       = list;
      _trends        = NetTrendAnalyzer.analyze(list);
      _weeklyReport  = WeeklyReport.generate(list);
    });
  }

  Future<void> _save(TryoutExam t) async {
    _tryouts.insert(0, t);
    final encoded = _tryouts.map((e) => jsonEncode(e.toJson())).toList();
    unawaited(AppState.prefs.setStringList('tryouts', encoded));
    final ids = AppState.earnedBadgeIds;
    if (_tryouts.length >= 5  && !ids.contains('tryout_5'))  widget.onXPAward(50,  badgeId: 'tryout_5');
    if (_tryouts.length >= 20 && !ids.contains('tryout_20')) widget.onXPAward(150, badgeId: 'tryout_20');
    _trends        = NetTrendAnalyzer.analyze(_tryouts);
    _weeklyReport  = WeeklyReport.generate(_tryouts);
    widget.onTaskComplete?.call();
    if (!mounted) return;
    setState(() {});
  }

  Future<void> _delete(String id) async {
    _tryouts.removeWhere((t) => t.id == id);
    unawaited(AppState.prefs.setStringList('tryouts', _tryouts.map((e) => jsonEncode(e.toJson())).toList()));
    _trends       = NetTrendAnalyzer.analyze(_tryouts);
    _weeklyReport = WeeklyReport.generate(_tryouts);
    if (!mounted) return;
    setState(() {});
  }

  void _showAdd() {
    showModalBottomSheet(
      context: context, isScrollControlled: true, backgroundColor: Colors.transparent,
      builder: (_) => AddTryoutSheet(onSave: (t) async { await _save(t); widget.onXPAward(15); }),
    );
  }

  @override
  Widget build(BuildContext context) {
    super.build(context);
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF6F8FA),
      appBar: AppBar(
        title: Text('Denemelerim (${_tryouts.length})', style: _ts(size: 17, w: FontWeight.w700, color: Colors.white)),
        automaticallyImplyLeading: false,
        backgroundColor: isDark ? kCard : kPrimary, foregroundColor: Colors.white, elevation: 0,
        actions: [IconButton(icon: const Icon(Icons.add_rounded), onPressed: _showAdd)],
      ),
      floatingActionButton: _tryouts.isNotEmpty
        ? FloatingActionButton.extended(onPressed: _showAdd, icon: const Icon(Icons.add), label: const Text('Deneme Ekle'), backgroundColor: kPrimary)
