          child: Row(children: [
            SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2, color: kPrimary)),
            SizedBox(width: 10),
            Text('Claude düşünüyor...', style: TextStyle(color: kPrimary, fontSize: 13)),
          ]),
        ),

        if (_history.isEmpty && !_loading) Padding(
