      'Olasılık', 'Denklemler', 'Üçgenler'],
  };

  @override
  void initState() { super.initState(); _load(); }

  Future<void> _load() async {
    final data = AppState.prefs.getString('topics_$_sel');
    final todayKey = 'topics_today_count';
    final todayDate = AppState.prefs.getString('topics_today_date') ?? '';
    final now = DateTime.now();
    final today = '${now.year}-${now.month.toString().padLeft(2,'0')}-${now.day.toString().padLeft(2,'0')}';

    if (!mounted) return;
    setState(() {
      _done = data != null ? Map<String, bool>.from(jsonDecode(data) as Map) : {};
      _todayChecked = (todayDate == today) ? (AppState.prefs.getInt(todayKey) ?? 0) : 0;
    });
  }

  Future<void> _saveData() async {
    unawaited(AppState.prefs.setString('topics_$_sel', jsonEncode(_done)));
  }

  void _toggle(String topic) async {
    final wasChecked = _done[topic] ?? false;
    setState(() => _done[topic] = !wasChecked);
    unawaited(_saveData());

    if (!wasChecked) {
      // Yeni tamamlanan konu
      final now = DateTime.now();
      final today = '${now.year}-${now.month.toString().padLeft(2,'0')}-${now.day.toString().padLeft(2,'0')}';
      final stored = AppState.prefs.getString('topics_today_date') ?? '';
      int count = (stored == today) ? (AppState.prefs.getInt('topics_today_count') ?? 0) : 0;
      count++;
      unawaited(AppState.prefs.setString('topics_today_date', today));
      unawaited(AppState.prefs.setInt('topics_today_count', count));
      setState(() => _todayChecked = count);

      if (count >= 3) widget.onTaskComplete?.call();
    }
  }

