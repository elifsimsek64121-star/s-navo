                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: isUser ? kPrimary : (isDark ? kCardElevated : const Color(0xFFF6F8FA)),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    // FIX: Colors.white80 does not exist → Colors.white.withAlpha(204)
