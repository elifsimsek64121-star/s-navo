              if (_trends.isNotEmpty) _buildTrendSummary(isDark),

              // ─── Denemeler ───
              ..._tryouts.asMap().entries.map((entry) {
                final t = entry.value;
                final s = t.score;
                final scoreColor = s >= 400 ? kSuccess : s >= 250 ? kWarning : kDanger;
                return Dismissible(
                  key: Key(t.id),
                  direction: DismissDirection.endToStart,
