                ],

                // ─── Ders Ortalamaları ───
                if (_subjectAverages.isNotEmpty) ...[
                  Text('Ders Ortalama Netleri', style: _ts(size: 16, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
