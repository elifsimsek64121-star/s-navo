      body: _tryouts.isEmpty
        ? Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            Icon(Icons.assignment_outlined, size: 64, color: isDark ? Colors.white24 : Colors.black26),
            const SizedBox(height: 16),
            Text('Henüz deneme eklenmedi', style: _ts(size: 18, w: FontWeight.w600, color: isDark ? Colors.white54 : Colors.black45)),
            const SizedBox(height: 8),
            Text('Her denemenizi kaydedin, gelişiminizi takip edin!', textAlign: TextAlign.center, style: _ts(size: 13, color: isDark ? Colors.white38 : Colors.black38)),
            const SizedBox(height: 24),
            ElevatedButton.icon(onPressed: _showAdd, icon: const Icon(Icons.add_rounded), label: const Text('İlk Denemeyi Ekle')),
