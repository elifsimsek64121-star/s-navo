class AppState {
  static SharedPreferences? _prefs;
  static bool _initDone = false;

  static int streak = 0;
  static int xp = 0;
  static int level = 1;
  static Set<String> favorites = {};
  static List<String> earnedBadgeIds = [];
  static List<DailyTask> dailyTasks = [];
  static String? lastDailyReset;

  static Future<void> bootstrap() async {
    if (_initDone) return;
    _prefs = await SharedPreferences.getInstance();
    _initDone = true;
  }

  static SharedPreferences get prefs {
    assert(_initDone, 'AppState.bootstrap() must be called first');
    return _prefs!;
  }

  static Future<void> loadUserData() async {
    final p = prefs;
    final now = DateTime.now();
    final today = '${now.year}-${now.month.toString().padLeft(2,'0')}-${now.day.toString().padLeft(2,'0')}';
    final lastStr = p.getString('last_open_date');
    int s = p.getInt('streak') ?? 0;

    if (lastStr != null && lastStr != today) {
      try {
        final last = DateTime.parse(lastStr);
        final diff = now.difference(last).inDays;
        s = diff == 1 ? s + 1 : 1;
      } catch (_) { s = 1; }
    } else if (lastStr == null) { s = 1; }

    if (lastStr != today) unawaited(p.setString('last_open_date', today));
    unawaited(p.setInt('streak', s));

    int xpVal = p.getInt('xp_points') ?? 0;
    final ids = List<String>.from(p.getStringList('earned_badges') ?? []);
    bool changed = false;
    if (s >= 3  && !ids.contains('streak_3'))  { ids.add('streak_3');  xpVal += 50;  changed = true; }
    if (s >= 7  && !ids.contains('streak_7'))  { ids.add('streak_7');  xpVal += 100; changed = true; }
    if (s >= 30 && !ids.contains('streak_30')) { ids.add('streak_30'); xpVal += 300; changed = true; }
    if (changed) {
      unawaited(p.setStringList('earned_badges', ids));
      unawaited(p.setInt('xp_points', xpVal));
    }

    streak = s;
    xp = xpVal;
    level = (xpVal ~/ 100) + 1;
    favorites = (p.getStringList('favorites') ?? []).toSet();
    earnedBadgeIds = ids;
    lastDailyReset = p.getString('daily_reset');
    _refreshDailyTasks(today);
  }

  static void _refreshDailyTasks(String today) {
    if (lastDailyReset == today) {
      // Bugün zaten yenilendi, tamamlanma durumlarını yükle
      final doneIds = (prefs.getStringList('daily_done') ?? []).toSet();
      dailyTasks = _buildDailyTasks(doneIds);
    } else {
      // Yeni gün → sıfırla
      dailyTasks = _buildDailyTasks({});
      unawaited(prefs.setString('daily_reset', today));
      unawaited(prefs.setStringList('daily_done', []));
    }
  }

  static List<DailyTask> _buildDailyTasks(Set<String> doneIds) => [
    DailyTask(id: 'daily_calc',    title: 'Bugün puan hesapla',        emoji: '🎯', xpReward: 10, completed: doneIds.contains('daily_calc')),
    DailyTask(id: 'daily_tryout',  title: '1 deneme sonucu gir',       emoji: '📝', xpReward: 20, completed: doneIds.contains('daily_tryout')),
    DailyTask(id: 'daily_topic',   title: '3 konu işaretle',           emoji: '✅', xpReward: 15, completed: doneIds.contains('daily_topic')),
    DailyTask(id: 'daily_coach',   title: 'AI Koç\'tan öneri al',      emoji: '🤖', xpReward: 10, completed: doneIds.contains('daily_coach')),
    DailyTask(id: 'daily_streak',  title: 'Serini koru (giriş yap)',   emoji: '🔥', xpReward: 5,  completed: true), // Her gün otomatik tamamlanır
  ];

  static Future<void> completeTask(String taskId) async {
    final task = dailyTasks.firstWhere((t) => t.id == taskId, orElse: () => DailyTask(id: '', title: '', emoji: '', xpReward: 0));
    if (task.id.isEmpty || task.completed) return;
    task.completed = true;
    await addXP(task.xpReward, badgeId: null);
    final doneIds = dailyTasks.where((t) => t.completed).map((t) => t.id).toList();
    unawaited(prefs.setStringList('daily_done', doneIds));
  }

  static Future<void> addXP(int amount, {String? badgeId}) async {
    xp += amount;
    level = (xp ~/ 100) + 1;
    unawaited(prefs.setInt('xp_points', xp));
    if (badgeId != null && !earnedBadgeIds.contains(badgeId)) {
      earnedBadgeIds.add(badgeId);
      unawaited(prefs.setStringList('earned_badges', earnedBadgeIds));
    }
  }
}

