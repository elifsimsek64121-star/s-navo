// NET TREND ANALYZER
// ─────────────────────────────────────────────────────────────
class NetTrendResult {
  final String label;
  final String emoji;
  final Color color;
  final String advice;
  const NetTrendResult({required this.label, required this.emoji, required this.color, required this.advice});
}

class NetTrendAnalyzer {
  /// Son denemelerden ders bazlı trend hesapla
  static Map<String, NetTrendResult> analyze(List<TryoutExam> tryouts) {
    if (tryouts.length < 2) return {};
    final result = <String, NetTrendResult>{};
    // Tüm ders adlarını topla
    final allSubjects = <String>{};
    for (final t in tryouts) allSubjects.addAll(t.nets.keys);

    for (final sub in allSubjects) {
      final vals = tryouts.map((t) => t.nets[sub]).whereType<double>().toList();
      if (vals.length < 2) continue;
      final recent = vals.take(3).toList();
      final older  = vals.skip(3).take(3).toList();

      final recentAvg = recent.reduce((a, b) => a + b) / recent.length;
      final olderAvg  = older.isEmpty ? recentAvg : older.reduce((a, b) => a + b) / older.length;
      final delta     = recentAvg - olderAvg;

      // Son 2 deneme trendi
      final last2Delta = vals.length >= 2 ? vals[0] - vals[1] : 0.0;

      NetTrendResult r;
      if (delta > 1.5 || last2Delta > 2) {
        r = NetTrendResult(
          label: 'Yükseliyor',
          emoji: '🔥',
          color: kSuccess,
          advice: '$sub\'de harika ilerliyorsun! Devam et.',
        );
      } else if (delta < -1.5 || last2Delta < -2) {
        r = NetTrendResult(
          label: 'Düşüşte',
          emoji: '⚠️',
          color: kDanger,
          advice: '$sub düşüyor! Bu derse öncelik ver.',
        );
      } else {
        r = NetTrendResult(
          label: 'Stabil',
          emoji: '👍',
          color: kWarning,
          advice: '$sub sabit. Biraz daha iterek artırabilirsin.',
        );
      }
      result[sub] = r;
    }
    return result;
  }

  /// Hedef puana ulaşmak için gereken ek net
  static Map<String, String> goalAnalysis(List<TryoutExam> tryouts, double targetScore, String examId) {
    if (tryouts.isEmpty) return {};
    final last = tryouts.first;
    final currentScore = last.score;
    final gap = targetScore - currentScore;

    // Hangi ders, kaç net artırırsa yaklaşık kaç puan kazanır?
    // TYT için katsayılar
    final coeffMap = <String, double>{
      'Türkçe': 3.3, 'Matematik': 3.3, 'Sosyal Bilimler': 3.4, 'Fen Bilimleri': 3.4,
      'AYT Matematik': 3.0, 'Fizik': 2.85, 'Kimya': 3.07, 'Biyoloji': 3.07,
    };

    if (gap <= 0) return {'status': '✅ Hedefini zaten geçiyorsun!'};

    final res = <String, String>{};
    res['gap'] = gap.toStringAsFixed(1);

    // En kolay artırılabilecek ders (en düşük net)
    if (last.nets.isNotEmpty) {
      final weakEntry = last.nets.entries.reduce((a, b) => a.value < b.value ? a : b);
      final coeff = coeffMap[weakEntry.key] ?? 3.0;
      final neededNet = (gap / coeff).ceil();
      res['advice'] = '${weakEntry.key}\'de +$neededNet net artır → hedefe ulaş!';
    }

    return res;
  }
}

// ─────────────────────────────────────────────────────────────
// WEEKLY REPORT GENERATOR
// ─────────────────────────────────────────────────────────────
class WeeklyReport {
  final String bestSubject;
  final String worstSubject;
  final double avgNetChange;
  final double avgScore;
  final int tryoutCount;
  final String insight;

  const WeeklyReport({
    required this.bestSubject,
    required this.worstSubject,
    required this.avgNetChange,
    required this.avgScore,
    required this.tryoutCount,
    required this.insight,
  });

  static WeeklyReport? generate(List<TryoutExam> tryouts) {
    final weekAgo = DateTime.now().subtract(const Duration(days: 7));
    final weekTryouts = tryouts.where((t) => t.date.isAfter(weekAgo)).toList();
    if (weekTryouts.isEmpty) return null;

    final netAverages = <String, double>{};
    for (final t in weekTryouts) {
      t.nets.forEach((sub, net) {
        netAverages[sub] = (netAverages[sub] ?? 0) + net;
      });
    }
    netAverages.updateAll((k, v) => v / weekTryouts.length);

    if (netAverages.isEmpty) return null;

    final best  = netAverages.entries.reduce((a, b) => a.value > b.value ? a : b);
    final worst = netAverages.entries.reduce((a, b) => a.value < b.value ? a : b);
    final avgScore = weekTryouts.map((t) => t.score).reduce((a, b) => a + b) / weekTryouts.length;

    // Önceki hafta ile kıyasla
    final prevWeek = DateTime.now().subtract(const Duration(days: 14));
    final prevTryouts = tryouts.where((t) => t.date.isAfter(prevWeek) && t.date.isBefore(weekAgo)).toList();
    double netChange = 0;
    if (prevTryouts.isNotEmpty) {
      final prevAvgScore = prevTryouts.map((t) => t.score).reduce((a, b) => a + b) / prevTryouts.length;
      netChange = avgScore - prevAvgScore;
    }

    String insight;
    if (weekTryouts.length >= 3 && netChange > 5) {
      insight = '🚀 Harika bir hafta! Ortalama ${netChange.toStringAsFixed(1)} puan arttı.';
    } else if (netChange < -5) {
      insight = '📉 Bu hafta düşüş var. ${worst.key} konusuna odaklan.';
    } else if (weekTryouts.length < 2) {
      insight = '📚 Bu hafta az deneme girdin. Daha fazla pratik yap!';
    } else {
      insight = '📊 Stabil bir hafta. ${best.key} en güçlü dersin.';
    }

    return WeeklyReport(
      bestSubject: best.key,
      worstSubject: worst.key,
      avgNetChange: netChange,
      avgScore: avgScore,
      tryoutCount: weekTryouts.length,
      insight: insight,
    );
  }
}

