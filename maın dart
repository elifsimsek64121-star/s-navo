class AdManager {
  static InterstitialAd? _interstitial;
  static RewardedAd?     _rewarded;
  static bool _intLoaded    = false;
  static bool _rewardLoaded = false;
  static int  _clickCount   = 0;
  static bool _initialized  = false;

  static void preloadAsync() {
    if (_initialized) return;
    _initialized = true;
    _loadInterstitial();
    _loadRewarded();
  }

  static void _loadInterstitial() {
    try {
      InterstitialAd.load(
        adUnitId: kInterstitialAdId,
        request: const AdRequest(),
        adLoadCallback: InterstitialAdLoadCallback(
          onAdLoaded: (ad) { _interstitial = ad; _intLoaded = true; },
          onAdFailedToLoad: (_) { _intLoaded = false; Future.delayed(const Duration(seconds: 90), _loadInterstitial); },
        ),
      );
    } catch (_) {}
  }

  static void _loadRewarded() {
    try {
      RewardedAd.load(
        adUnitId: kRewardedAdUnitId,
        request: const AdRequest(),
        rewardedAdLoadCallback: RewardedAdLoadCallback(
          onAdLoaded: (ad) { _rewarded = ad; _rewardLoaded = true; },
          onAdFailedToLoad: (_) { _rewardLoaded = false; Future.delayed(const Duration(seconds: 90), _loadRewarded); },
        ),
      );
    } catch (_) {}
  }

  static void tryShowInterstitial({int every = 6, VoidCallback? onDone}) {
    _clickCount++;
    if (_clickCount % every == 0 && _intLoaded && _interstitial != null) {
      _interstitial!.fullScreenContentCallback = FullScreenContentCallback(
        onAdDismissedFullScreenContent: (ad) { ad.dispose(); _interstitial = null; _intLoaded = false; _loadInterstitial(); onDone?.call(); },
        onAdFailedToShowFullScreenContent: (ad, _) { ad.dispose(); _interstitial = null; _intLoaded = false; _loadInterstitial(); onDone?.call(); },
      );
      _interstitial!.show();
    } else { onDone?.call(); }
  }

  static void showRewarded({required VoidCallback onRewarded, VoidCallback? onNotAvailable}) {
    if (!_rewardLoaded || _rewarded == null) { onNotAvailable?.call(); return; }
    _rewarded!.fullScreenContentCallback = FullScreenContentCallback(
      onAdDismissedFullScreenContent: (ad) { ad.dispose(); _rewarded = null; _rewardLoaded = false; _loadRewarded(); },
      onAdFailedToShowFullScreenContent: (ad, _) { ad.dispose(); _rewarded = null; _rewardLoaded = false; _loadRewarded(); onNotAvailable?.call(); },
    );
    _rewarded!.show(onUserEarnedReward: (_, __) => onRewarded());
  }

  static void dispose() { _interstitial?.dispose(); _rewarded?.dispose(); _interstitial = null; _rewarded = null; }
}

