class _AiCoachCard extends StatefulWidget {
  final VoidCallback? onCoachUsed;
  const _AiCoachCard({this.onCoachUsed});
  @override State<_AiCoachCard> createState() => _AiCoachCardState();
}

class _AiCoachCardState extends State<_AiCoachCard> {
  String _resp    = '';
  bool _loading   = false;
  bool _disposed  = false;
  final _msgCtrl  = TextEditingController();
  final List<Map<String, String>> _history = []; // {role, content}

  @override
  void dispose() { _disposed = true; _msgCtrl.dispose(); super.dispose(); }

  Future<void> _sendMessage([String? overrideMsg]) async {
    final msg = overrideMsg ?? _msgCtrl.text.trim();
    if (msg.isEmpty || _loading || _disposed) return;
    _msgCtrl.clear();

    if (mounted) setState(() { _loading = true; });

    // Kullanıcı bağlamı topla
    final p = AppState.prefs;
    final hist    = p.getStringList('history')  ?? [];
    final tryouts = p.getStringList('tryouts')  ?? [];
    final streak  = AppState.streak;

    final sb = StringBuffer();
    if (hist.isNotEmpty) {
      try {
        final latest = jsonDecode(hist.first) as Map<String, dynamic>;
        sb.write('Son hesaplama: ${latest['examTitle']} – ${latest['score']} puan. ');
      } catch (_) {}
    }
    if (tryouts.isNotEmpty) {
      try {
        final latest = TryoutExam.fromJson(jsonDecode(tryouts.first) as Map<String, dynamic>);
        if (latest.nets.isNotEmpty) {
          final weak = latest.nets.entries.reduce((a, b) => a.value < b.value ? a : b);
          final best = latest.nets.entries.reduce((a, b) => a.value > b.value ? a : b);
          sb.write('En zayıf: ${weak.key} (${weak.value.toStringAsFixed(1)} net). ');
          sb.write('En güçlü: ${best.key} (${best.value.toStringAsFixed(1)} net). ');
          sb.write('Son puan: ${latest.score.toStringAsFixed(1)}. ');
        }
      } catch (_) {}
    }
    sb.write('Çalışma serisi: $streak gün.');

    _history.add({'role': 'user', 'content': msg});

    if (kAnthropicApiKey.isEmpty) {
      _setFallback(msg);
      widget.onCoachUsed?.call();
      return;
    }

    http.Client? client;
    try {
      client = http.Client();
      final messages = _history.map((m) => {'role': m['role']!, 'content': m['content']!}).toList();

      // FIX: Fixed string interpolation – was $_{ sb.toString() }, now ${sb.toString()}
      final res = await client.post(
        Uri.parse('https://api.anthropic.com/v1/messages'),
        headers: {'Content-Type': 'application/json', 'x-api-key': kAnthropicApiKey, 'anthropic-version': '2023-06-01'},
        body: jsonEncode({
          'model': kClaudeModel,
          'max_tokens': 800,
          'system':
            'Sen deneyimli bir Türk sınav koçusun. Öğrenci verisi: ${sb.toString()}\n'
            'Her zaman Türkçe yaz. Samimi, motive edici ve somut öneriler ver. '
            'Cevaplar kısa ve etkili olsun (max 5 cümle). Emojiler kullan.',
          'messages': messages,
        }),
      ).timeout(const Duration(seconds: 30));

      if (_disposed) return;
      if (res.statusCode == 200) {
        final data = jsonDecode(utf8.decode(res.bodyBytes)) as Map<String, dynamic>;
        final text = (data['content'] as List).whereType<Map<String, dynamic>>()
          .where((c) => c['type'] == 'text').map((c) => c['text'] as String).join('\n');
        _history.add({'role': 'assistant', 'content': text.trim()});
        if (!_disposed && mounted) setState(() { _resp = text.trim(); _loading = false; });
      } else { _setFallback(msg); }
    } on TimeoutException { _setFallback(msg); }
    catch (_) { _setFallback(msg); }
    finally { client?.close(); }

    widget.onCoachUsed?.call();
  }

  void _setFallback(String msg) {
    if (_disposed) return;
    final responses = [
      '🎯 Zayıf dersine günde 2 saat ayır. Yanlış yaptığın soruları özel deftere yaz ve her gün tekrar et!',
      '📚 Pomodoro tekniği dene: 25 dk çalış, 5 dk mola. 4 turdan sonra 20 dk uzun mola. Odak artar!',
      '🔥 Serin harika! Tutarlılık her şeyden önemli. Şu an yaptıkların birikerek büyüyecek.',
      '📊 Son denemeni analiz et: hangi konulardan hata yaptın? O konulara öncelik ver.',
      '💡 Hedef puanına odaklan. Her doğru cevap seni 1 adım daha yaklaştırıyor. Devam et!',
    ];
    final r = responses[DateTime.now().second % responses.length];
    _history.add({'role': 'assistant', 'content': r});
    if (mounted) setState(() { _resp = r; _loading = false; });
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        color: isDark ? kCard : Colors.white,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: const Color(0x3D0A84FF)),
      ),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Container(
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(color: const Color(0x190A84FF), borderRadius: BorderRadius.circular(10)),
            child: const Icon(Icons.smart_toy_rounded, color: kPrimary, size: 22),
          ),
          const SizedBox(width: 12),
          Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text('Claude AI Koç', style: _ts(size: 16, w: FontWeight.w800, color: isDark ? Colors.white : Colors.black87)),
            Text('Kişisel sınav koçun – soru sorabilirsin!', style: _ts(size: 12, color: isDark ? Colors.white38 : Colors.black38)),
          ])),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
            decoration: BoxDecoration(color: const Color(0x193FB950), borderRadius: BorderRadius.circular(8), border: Border.all(color: const Color(0x3C3FB950))),
            child: Text('CANLI', style: _ts(size: 10, w: FontWeight.w800, color: kSuccess)),
          ),
        ]),

        // Sohbet geçmişi (son 6 mesaj)
        if (_history.isNotEmpty) ...[
          const SizedBox(height: 14),
          Container(
            constraints: const BoxConstraints(maxHeight: 250),
            child: ListView(
              shrinkWrap: true,
              children: _history.takeLast(6).map((m) {
                final isUser = m['role'] == 'user';
                return Align(
