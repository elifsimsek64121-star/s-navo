class HistoryScreen extends StatefulWidget {
  const HistoryScreen({super.key});
  @override State<HistoryScreen> createState() => _HistoryScreenState();
}

class _HistoryScreenState extends State<HistoryScreen> {
  List<Map<String, dynamic>> _history = [];

  @override
  void initState() { super.initState(); _load(); }

  void _load() {
    final raw = AppState.prefs.getStringList('history') ?? [];
    final parsed = <Map<String, dynamic>>[];
    for (final h in raw) {
      try { parsed.add(jsonDecode(h) as Map<String, dynamic>); } catch (_) {}
    }
    setState(() => _history = parsed);
  }

  Future<void> _clearAll() async {
    final ok = await showDialog<bool>(context: context, builder: (_) => AlertDialog(
      title: const Text('Geçmişi Temizle?'),
      content: const Text('Tüm hesaplama geçmişi silinecek.'),
      actions: [
        TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('İptal')),
        TextButton(onPressed: () => Navigator.pop(context, true), child: const Text('Sil', style: TextStyle(color: kDanger))),
      ],
    ));
    if (ok == true && mounted) {
      unawaited(AppState.prefs.setStringList('history', []));
      setState(() => _history = []);
    }
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF6F8FA),
      appBar: AppBar(
        title: Text('Geçmiş (${_history.length})', style: _ts(size: 17, w: FontWeight.w700, color: Colors.white)),
        backgroundColor: isDark ? kCard : kPrimary, foregroundColor: Colors.white, elevation: 0,
        actions: [if (_history.isNotEmpty) IconButton(icon: const Icon(Icons.delete_outline_rounded), onPressed: _clearAll)],
      ),
      body: _history.isEmpty
        ? Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            Icon(Icons.history_rounded, size: 64, color: isDark ? Colors.white24 : Colors.black26),
            const SizedBox(height: 16),
            Text('Henüz hesaplama yapılmadı', style: _ts(size: 16, w: FontWeight.w600, color: isDark ? Colors.white54 : Colors.black45)),
          ]))
        : ListView.builder(
            padding: const EdgeInsets.all(14),
            itemCount: _history.length,
            addAutomaticKeepAlives: false,
            addRepaintBoundaries: false,
            itemBuilder: (_, i) {
              final h = _history[i];
              final date = DateTime.tryParse(h['date']?.toString() ?? '');
              final scoreStr = h['score']?.toString() ?? '0';
              final score    = double.tryParse(scoreStr) ?? 0;
              final scoreColor = score >= 400 ? kSuccess : score >= 250 ? kWarning : kDanger;
              return Container(
                margin: const EdgeInsets.only(bottom: 8),
                decoration: BoxDecoration(
                  color: isDark ? kCard : Colors.white,
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: isDark ? kBorder : const Color(0xFFE1E4E8)),
                ),
                child: ListTile(
                  leading: Container(width: 42, height: 42,
                    decoration: BoxDecoration(color: const Color(0x140A84FF), borderRadius: BorderRadius.circular(10)),
                    child: const Icon(Icons.calculate_rounded, color: kPrimary, size: 20)),
                  title: Text(h['examTitle']?.toString() ?? '', style: _ts(size: 14, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
                  subtitle: date != null
                    ? Text('${date.day}.${date.month}.${date.year}  ${date.hour}:${date.minute.toString().padLeft(2, '0')}',
                        style: _ts(size: 11, color: isDark ? Colors.white38 : Colors.black38))
                    : null,
                  trailing: Text(scoreStr, style: _ts(size: 20, w: FontWeight.w900, color: scoreColor)),
                ),
              );
            },
          ),
    );
  }
}

